# ─────────────────────────────────────────────────────────────
# VideoRAG configuration. Copy to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Qdrant ───────────────────────────────────────────────────
# Qdrant Cloud:   https://<cluster-id>.<region>.cloud.qdrant.io:6333  (+ API key)
# Local Docker:   http://localhost:6333   (docker run -p 6333:6333 qdrant/qdrant)
# Leave EMPTY to use an embedded on-disk Qdrant (QDRANT_LOCAL_PATH), no server needed.
# Change :6333 or :433 to :443:
QDRANT_URL: str = "https://2af73648-2e26-4823-9d18-754dd5dfea23.ca-central-1-0.aws.cloud.qdrant.io:443"
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6MWYyNmFkNjYtMzlkYS00YTRiLTllMDQtYzU2MzNhMWJjNWYzIn0.MjjETXzbzdBTQQ09q9LyNiOZk4ISfMDfSPLZlFLySCs
QDRANT_LOCAL_PATH=./qdrant_data

# Default collection used when the UI/API does not specify one.
COLLECTION_NAME=videorag

# ── Embeddings ───────────────────────────────────────────────
# Local (free, no key):  sentence-transformers/all-MiniLM-L6-v2   (384 dims)
# OpenAI (needs key):    text-embedding-3-small                   (1536 dims)
# NOTE: a collection is tied to one embedding model. Change the model => use a new COLLECTION_NAME.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM for answer synthesis ─────────────────────────────────
# auto = first provider with a key (anthropic > openai > groq).
# With no key at all, VideoRAG still works and returns the best matching passages.
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=groq_api_key_here
GROQ_MODEL: str = "llama-3.1-8b-instant"

# ── Ingestion / retrieval tuning ─────────────────────────────
CHUNK_SECONDS=60            # target length of each transcript chunk
CHUNK_OVERLAP_SECONDS=10    # overlap between neighbouring chunks
MAX_CHUNK_CHARS=1500
MAX_PLAYLIST_VIDEOS=50
TOP_K=6

# Comma-separated list of allowed CORS origins, or *
CORS_ORIGINS=*
